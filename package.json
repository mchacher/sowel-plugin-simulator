{
  "name": "sowel-plugin-simulator",
  "version": "0.1.0",
  "description": "Sowel plugin: a simulated home (occupants, sun, weather, thermal, energy) published as ordinary devices",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write --no-error-on-unmatched-pattern \"src/**/*.ts\" \"scripts/**/*.ts\" \"*.{json,md,js}\" \"specs/**/*.md\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"src/**/*.ts\" \"scripts/**/*.ts\" \"*.{json,md,js}\" \"specs/**/*.md\"",
    "validate": "npm run typecheck && npm run typecheck:tests && npm run lint && npm run format:check && npm test && npm run build && bash scripts/check-specs-index.sh",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,js}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "license": "AGPL-3.0"
}
